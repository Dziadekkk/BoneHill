@373 = ~Na po³udnie do Garrotten~
@374 = ~Widzisz ma³y tunel. By³ doskonale ukryty i nie wygl¹da, jakby by³ u¿ywany. Coœ blokujê ci drogê do wejœcia.~
@375 = ~Ktoœ wykopa³ tunel pod ogrodzeniem.~
@376 = ~To musi byæ drzewo, na którym wieszano ludzi. Z ogromnych ga³êzi zwisa kilka starych lin.~
@377 = ~Trójszczyt~
@378 = ~Têdy dojdziesz z powrotem do o³tarza. Mo¿esz zakryæ schody, aby nikt nie wiedzia³, ¿e ktoœ schodzi³ na dó³.~
@379 = ~W tych koszarach na pewno wybuch³ kiedyœ po¿ar. Wiêkszoœæ dachu jest doszczêtnie spalona.~
@380 = ~Dom wygl¹da na opuszczony. Drzwi s¹ zaroœniête pn¹czami i krzakami.~
@381 = ~£ó¿ko, stó³ i reszta mebli jest zbutwia³a i wygl¹da, jakby mia³a siê zaraz rozlecieæ.~
@382 = ~Zardzewia³y sztylet wbity w tarczê do æwiczeñ.~
@383 = ~Ten tunel jest tak ma³y, ¿e zmieszcz¹ siê tu jedynie szczury. To têdy wydostawa³y siê z jaskiñ.~
@384 = ~S¹dz¹c po szcz¹tkach, móg³ to byæ z³odziej. Poza koœæmi, ciemnym ubraniem i z³amanym wytrychem nie ma tu nic ciekawego.~
@385 = ~Baron Brodu Resten~
@386 = ~Wie¿a Pelltara~
@387 = ~Wyjœcie~
@388 = ~Tu le¿y Joe, który zwyk³ mawiaæ: „Ten mod mnie wykoñczy!”~
@389 = ~Wygl¹da to na œwie¿y grób.~
@390 = ~Jest tutaj ma³y tunel prowadz¹cy w dó³.~
@391 = ~Ten szkielet jest jeszcze œwie¿y. Pozosta³oœci ciemnych szat sugeruj¹, ¿e to zw³oki czarodzieja.~
@392 = ~Chyba ktoœ przebudowywa³ tê katapultê. Kilka belek zosta³o wymienionych.~
@393 = ~Zauwa¿asz, ¿e okolica jest ca³kowicie pozbawiona roœlinnoœci.~
@394 = ~Wygl¹da to na ma³y, niedawno opuszczony fort. Lada moment siê zawali.~
