@18 = ~Tak! Kontrolujê nas. Bêdê nowym baronem. Bêdê nimi rz¹dziæ. Wezmê Andrellê za ¿onê! A potem, potem... zabijê ksiêcia. Tak, tak.~
@19 = ~Ale najpierw, wy wœcibscy durnie, bêdziecie cierpieæ!~
@20 = ~To fatalnie. Biedna rodzina jest tak strapiona.~
