@1 = ~Ach, poszukiwacze przygód. Szukam ludzi do wynajêcia, którzy bêd¹ w stanie mi pomóc. Mogê zaj¹æ ci chwilkê? Proszê.~
@2 = ~Jasne, czemu nie.~
@3 = ~Byæ mo¿e. Ostatnio odnoszê wra¿enie, ¿e wszyscy chc¹, abym odwali³ za nich brudn¹ robotê.~ ~Byæ mo¿e. Ostatnio odnoszê wra¿enie, ¿e wszyscy chc¹, abym odwali³a za nich brudn¹ robotê.~
@4 = ~Oczywiœcie. Jestem czarodziejem zamieszka³ym w Brodzie Resten. Jest to ma³a mieœcina na wyspie Lendore.~
@5 = ~Zazwyczaj w naszym ma³ym rybackim miasteczku sprawy siê maj¹ bardzo dobrze. Ostatnimi czasy jednak¿e pojawi³y siê pewne problemy, których nie by³em w stanie zidentyfikowaæ.~
@6 = ~Niektóre karawany do nas nie dotar³y. Równie¿ kilku podró¿ników przyby³ych do naszego miasta wspomina³o coœ o hobgoblinach, gnollach oraz innych kreaturach nêkaj¹cych ich w trakcie podró¿y.~
@7 = ~W zasadzie nigdy nie zak³ada³em, ¿e wyspa jest wolna od tego typu stworów, jestem jednak zaniepokojony narastaj¹cymi problemami, jakie mog¹ one spowodowaæ.~
@8 = ~Mamy w okolicy ruiny oraz jaskinie, gdzie byæ mo¿e siê chowaj¹. Niestety nie mam czasu, aby zaj¹æ siê tymi sprawami. Jest trochê wiêkszych problemów z rodzin¹ Barona, którymi muszê siê zaj¹æ.~
@9 = ~A wiêc, <CHARNAME>? Pomo¿esz nam?~
@10 = ~Oczywiœcie.~
@11 = ~Nie s¹dzê.~
@12 = ~Mo¿e. Mo¿esz mi jeszcze raz powiedzieæ, czego chcesz?~
@13 = ~Przykro mi, ¿e stanê³o na niczym. Czy móg³byœ wróciæ do mnie, kiedy znajdziesz odrobinê czasu, by pomóc innym?~ ~Przykro mi, ¿e stanê³o na niczym. Czy mog³abyœ wróciæ do mnie, kiedy znajdziesz odrobinê czasu, by pomóc innym?~
@14 = ~Wspaniale. Poniewa¿ jesteœmy po³o¿eni z dala od g³ównego l¹du, musia³byœ wynaj¹æ statek, by siê tam dostaæ. Przeniosê nas bezpoœrednio na wyspê.~ ~Wspaniale. Poniewa¿ jesteœmy po³o¿eni z dala od g³ównego l¹du, musia³abyœ wynaj¹æ statek, by siê tam dostaæ. Przeniosê nas bezpoœrednio na wyspê.~
@15 = ~Có¿, bêdê wypatrywa³ innych awanturników. Gdybyœ zmieni³ zdanie, proszê, wróæ tutaj.~ ~Có¿, bêdê wypatrywa³ innych awanturników. Jeœli zmieni³abyœ zdanie, proszê, wróæ tutaj.~
@16 = ~Jesteœmy na miejscu. Witaj w Brodzie Resten. Rozejrzyjcie siê po mieœcie. Z pewnoœci¹ odkryjesz, ¿e ludzie ju¿ wiedz¹ o twoim przybyciu. Wieœci szybko siê tu rozchodz¹. Proszê tylko, nie prowokuj stra¿y, by ganiali za tob¹. Jeœli o nich chodzi, baron jest bardzo surowy. Za zabójstwo stra¿nika – natychmiastowa œmieæ. Nie bêdê w stanie przeciwdzia³aæ tej decyzji. Pamiêtaj, jesteœ tutaj z misj¹.~
@17 = ~Znajdziesz mnie albo w mym domostwie, albo w wie¿y za zamkiem. Daj mi, proszê, znaæ, gdy tylko dowiesz siê czegoœ niezwyk³ego. Kiedy stwierdzisz, ¿e zakoñczy³eœ swoje zadanie, odeœlê ciê z powrotem do œwi¹tyni.~ ~Znajdziesz mnie albo w mym domostwie, albo w wie¿y za zamkiem. Daj mi, proszê znaæ, gdy tylko dowiesz siê czegoœ niezwyk³ego. Kiedy stwierdzisz, ¿e zakoñczy³aœ swoje zadanie, odeœlê ciê z powrotem do œwi¹tyni.~
@18 = ~Có¿, <CHARNAME>, uda³o ci siê odkryæ cokolwiek podejrzanego?~
@19 = ~Nic. Miasto ma siê dobrze. Nie rozumiem, o co siê tak zamartwia³eœ.~
@20 = ~ZnaleŸliœmy ca³¹ masê dziwnych rzeczy, miêdzy innymi pog³oski o agresywnych napaœciach okolicznych bandytów oraz innych intruzach atakuj¹cych waszych rzemieœlników.~
@21 = ~Zahrdahl nie ¿yje.~
@22 = ~Chyba nasza robota dobieg³a koñca. Mo¿esz nas ju¿ odes³aæ?~
@23 = ~Nie, Pelltarze, jeszcze nic. Wci¹¿ szukamy.~
@24 = ~Hmmm, dziwne. Informacje od moich kontaktów zazwyczaj siê sprawdzaj¹. No có¿, chyba przyjrzê siê temu na w³asn¹ rêkê.~
@25 = ~No proszê, to brzmi, jakbyœ mia³ sporo pracy. Powiedz mi, proszê, o wszystkich zajœciach, jakie mia³y miejsce od naszego ostatniego spotkania.~ ~No proszê, to brzmi, jakbyœ mia³a sporo pracy. Powiedz mi, proszê, o wszystkich zajœciach, jakie mia³y miejsce od naszego ostatniego spotkania.~
@26 = ~Porozmawialiœmy z mieszkañcami i wys³uchaliœmy wielu plotek oraz opowieœci o dziwnych wydarzeniach z okolicy. Postanowiliœmy przyjrzeæ siê tym opowieœciom bli¿ej.~
@27 = ~Dobra decyzja. Zadziwiaj¹ce jak wiele pospólstwo wie o okolicy. Czasami wydaje mi siê, ¿e wiedz¹ oni wiêcej ni¿ reszta nas, zw¹cych siê "wykszta³conymi".~
@28 = ~Doskonale. Wykonaliœcie kawa³ dobrej roboty, za co jestem wam dozgonnie wdziêczny. Jeœli jesteœcie gotowi, odeœlê was z powrotem do œwi¹tyni.~
@29 = ~Tak, proszê.~
@30 = ~Dziêki, ale jeszcze nie teraz. Chyba pozwiedzam sobie jeszcze okolicê.~
@31 = ~Có¿ wiêc znalaz³eœ?~ ~Có¿ wiêc znalaz³aœ?~
@32 = ~Odkryliœmy, ¿e bandyci atakowali karawany rzemieœlników naci¹gaj¹ce od wschodu. Poszliœmy wiêc na £yse wzgórze i zostaliœmy przez nich zaatakowani. Jak siê okaza³o, by³a to grupa orków z pó³orkiem kap³anem na czele.~
@33 = ~Dowiedzieliœmy siê o powa¿nym problemie zwi¹zanym ze szczurami w pobli¿u starych koszar. Poszliœmy zbadaæ tê sprawê i odkryliœmy pod koszarami star¹ jaskiniê.~
@34 = ~S³yszeliœmy, ¿e gnolle nêkaj¹ miasto. Poszliœmy na Trójszczyt i znaleŸliœmy ca³y ich szczep. Po d³ugiej i wyczerpuj¹cej bitwie natknêliœmy siê na ich wodza, którym by³ ogrzy mag. Krew siê pola³a, ale gnolle nie powinny ju¿ was niepokoiæ.~
@35 = ~Wspiêliœmy siê na Koœciane wzgórze i zwiedziliœmy tamtejsze ruiny.~
@36 = ~Z pewnoœci¹ bêdziesz tego potrzebowa³. To dziennik Zahrdahla, w³aœciciela sklepu z przynêtami.~
@37 = ~Musimy siê temu bli¿ej przyjrzeæ.~
@38 = ~Hmm, dobrze zorganizowane i poprowadzone. Mam tylko nadziejê, ¿e ich przywódca nie by³ pod czyimœ wp³ywem.~
@39 = ~Nie znaleŸliœmy niczego, co by na to wskazywa³o. Zabrzmia³o to tak, jakby by³ „wybawc¹” dóbr lub czegoœ innego.~
@40 = ~To jest mo¿liwe, jednak niczego wiêcej nie uda³o nam siê znaleŸæ.~
@41 = ~Na ca³e szczêœcie to by³o tylko to i nic bardziej z³owrogiego.~
@42 = ~W ka¿dym razie miasto jest bezpieczniejsze dziêki waszemu heroizmowi. Dziêkujê wam.~
@43 = ~Jaskinie? Jaskinie... hmm, tak, tak. Jakieœ sto lat temu albo i wiêcej pod koszarami zosta³y zbudowane tunele ci¹gn¹ce siê dalej przez ca³e miasto. By³y u¿ywane do przechowywania uzbrojenia. Póki nie zaczêliœmy stosowaæ magicznych schowków, tunele by³y wype³nione po brzegi. Te blisko rzeki by³y zagro¿one podtopieniem, tak wiêc by³y zbyt niebezpieczne, by dalej ich u¿ywaæ. Zastanawiam siê, jak wiele korytarzy wci¹¿ istnieje. Wracaj¹c do twoich przygód, wspomnia³eœ o...?~ ~Jaskinie? Jaskinie... hmm, tak, tak. Jakieœ sto lat temu albo i wiêcej pod koszarami zosta³y zbudowane tunele ci¹gn¹ce siê dalej przez ca³e miasto. By³y u¿ywane do przechowywania uzbrojenia. Póki nie zaczêliœmy stosowaæ magicznych schowków, tunele by³y wype³nione po brzegi. Te blisko rzeki by³y zagro¿one podtopieniem, tak wiêc by³y zbyt niebezpieczne, by dalej ich u¿ywaæ. Zastanawiam siê, jak wiele korytarzy wci¹¿ istnieje. Wracaj¹c do twoich przygód, wspomnia³aœ o...?~
@44 = ~Ktoœ odnalaz³ tamte jaskinie i u¿ywa³ ich jako kryjówki. ZnaleŸliœmy tam cia³o z³odzieja. By³y tam równie¿ szkielety oraz inni nieumarli, których prawdopodobnie rozz³oœciliœmy. ZnaleŸliœmy równie¿ ogromne gniazdo szczurów. Zabiliœmy ka¿dego, który siê nam nawin¹³, ale kto wie, czy jakieœ siê nie uchowa³y.~
@45 = ~Ogrzy mag dowodz¹cy gnollami? Zaprawdê dziwne zjawisko. Nigdy wczeœniej nie s³ysza³em, by gnolle pozwoli³y dowodziæ sob¹ komuœ innej rasy. Wspó³pracuj¹ z orkami oraz innymi stworzeniami, jednak nigdy nie mia³y ¿adnego z nich jako przywódcy. Bardzo dziwne... Jak mniemam, zbadaliœcie pozosta³e pog³oski i plotki?~
@46 = ~Owszem, jest to problem, z którym stra¿e bêd¹ w stanie ju¿ sobie poradziæ. Zabawnie by by³o zobaczyæ Gelpasa prowadz¹cego „szczurzy patrol”, co? Tak czy inaczej, dziêkujê ci za to dziwne odkrycie. Najlepiej bêdzie, jeœli stra¿e przeszukaj¹ dok³adnie te jaskinie i zablokuj¹ do nich dostêp. Nie chcielibyœmy, aby jacyœ z³oczyñcy z nich korzystali.~
@47 = ~Uch, w porz¹dku, ³apiê. Ale po co mi to?~
@48 = ~Poniewa¿ tak naprawdê by³ on szpiegiem na s³u¿bie ksiêcia.~
@49 = ~Co takiego!? Wiêc historie o szpiegu w mieœcie by³y prawdziwe. Wspania³a robota wywiadowcza. Baron musi siê o tym natychmiast dowiedzieæ. Jak mniemam, zaj¹³eœ siê tym „sprzedawc¹ przynêty”?~ ~Co takiego!? Wiêc historie o szpiegu w mieœcie by³y prawdziwe. Wspania³a robota wywiadowcza. Baron musi siê o tym natychmiast dowiedzieæ. Jak mniemam, zajê³aœ siê tym „sprzedawc¹ przynêty”?~
@50 = ~Ale¿ oczywiœcie. By³ kimœ w rodzaju maga. Posiada³ naprawdê niez³y sztylet, ale nie bêdzie mu ju¿ potrzebny.~
@51 = ~Nie, natychmiast przyszliœmy z tym do ciebie.~
@52 = ~Zmyœlne. Podejrzewam, ¿e by³by zbyt wielkim wyzwaniem dla stra¿ników. Proszê, zlikwiduj go natychmiast. Pewnie przyda ci siê jego dziennik. Dziêki temu zacznie gadaæ. Wróæ potem do mnie, a zaniosê dziennik do Barona Grellusa.~
@53 = ~Jaka¿ to ulga. Mieliœmy ju¿ wystarczaj¹co du¿o problemów z elfickimi w³adcami bez ich szpiegostwa. Nigdy nie doœæ nudy w naszym mieœcie. Dziêkujê ci za tw¹ pomoc.~
@54 = ~I?~
@55 = ~Czarnoksiê¿nik imieniem Telvar dowodzi³ band¹ hobgoblinów. Pozbyliœmy siê ich wszystkich. Mamy te¿ jego dziennik. Proszê bardzo.~
@56 = ~Pewien upiór kontrolowa³ wszelkiego rodzaju nieumar³ych wokó³ ruin Koœcianego wzgórza. Zniszczyliœmy go oraz jego s³ugi.~
@57 = ~Odkryliœmy czarnoksiê¿nika oraz upiora. Czarodziej dowodzi³ band¹ hobgoblinów, upiór natomiast hord¹ nieumar³ych. Wspólnie pracowali nad stworzeniem armii. Resten mia³o byæ pierwszym celem ich ataku. Unicestwiliœmy ich wraz z ich s³ugami. Czarnoksiê¿nik posiada³ dziennik, w którym znajduj¹ siê wszystkie plany. Proszê, weŸ, nam nie bêdzie potrzebny.~
@58 = ~Nie znaleŸliœmy niczego niepokoj¹cego. Niczego tam nie by³o.~
@59 = ~Hobgobliny oraz czarnoksiê¿nik? Có¿, byliby ³atwi do manipulacji. Stokrotne dziêki za zajêcie siê tym problemem. Baron jak najbardziej siê o tym dowie.~
@60 = ~Upiór wraz z nieumar³ymi? Nie zdziwi³bym siê, widz¹c tam nieumar³ych, ale to brzmi powa¿nie. Dziêkujê, ¿e zbadaliœcie to dla nas.~
@61 = ~Na niebiosa! Mieliœmy zostaæ zaatakowani? To okropne. Jestem niezmiernie zadowolony, ¿e poœwiêci³eœ swój czas, by nam pomóc. Naprawdê, bêdê musia³ koniecznie powiedzieæ o tym baronowi.~ ~Na niebiosa! Mieliœmy zostaæ zaatakowani? To okropne. Jestem niezmiernie zadowolony, ¿e poœwiêci³aœ swój czas, by nam pomóc. Naprawdê, bêdê musia³ koniecznie powiedzieæ o tym baronowi.~
@62 = ~<CHARNAME>, proszê, powiedz, ¿e to nieprawda.~
@63 = ~Nie mam pojêcia, o czym mówi Gelpas.~
@64 = ~Có¿, <CHARNAME>, wygl¹da na to, i¿ znów potrzebna nam bêdzie twoja pomoc. Poza sugesti¹ rozmowy z Welcarem nie mam pojêcia, jak¹ inn¹ wskazówkê mogê ci udzieliæ.~
@65 = ~Bardzo dobrze, pójdê z nim porozmawiaæ.~
@66 = ~Owszem, w³aœnie wyszed³. Dziêkujê za tê informacjê. Bandyci? <CHARNAME>, zdawa³o mi siê, ¿e siê nimi zaj¹³eœ?~ ~Owszem, w³aœnie wyszed³. Dziêkujê za tê informacjê. Bandyci? <CHARNAME>, zdawa³o mi siê, ¿e siê nimi zajê³aœ?~
@67 = ~Ale¿ zajêliœmy siê. To musi byæ inna grupa. Udam siê tam i dowiem siê, co siê dzieje.~
@68 = ~Jeszcze nie zajêliœmy siê t¹ spraw¹. Mo¿e to byæ inna grupa albo nawet ta sama. Udam siê w tamt¹ stronê i sprawdzê, co siê dzieje.~
@69 = ~Znalaz³eœ cokolwiek?~ ~Znalaz³aœ cokolwiek?~
@70 = ~Zabiliœmy bandytów. Przy jednym z nich znaleŸliœmy tê notkê. Wspomina coœ o „D³oni chwa³y”, cokolwiek mia³oby to oznaczaæ. Wydaje mi siê, ¿e to jej szukali.~
@71 = ~Zbadaliœmy stare kana³y i znaleŸliœmy zw³oki czarodzieja albo kogoœ, kto ubiorem go przypomina³. ZnaleŸliœmy równie¿ tê notatkê. Nie jesteœmy do koñca pewni, ale wygl¹da na mapê. Mówi ci to coœ?~
@72 = ~Jeszcze nie.~
@73 = ~Tak, znaleŸliœmy prawdziwego z³odzieja. Jego imiê to Syriusz i zosta³ on wynajêty przez elfich w³adców, by podwa¿yæ w³adzê barona.~
@74 = ~Tak, znaleŸliœmy prawdziwego z³odzieja. Jego imiê to Syriusz i zosta³ on wynajêty przez elfich w³adców, by podwa¿yæ w³adzê barona. Oto jego dziennik.~
@75 = ~Historyczne ksiêgi waszego miasta wspominaj¹ o systemie kana³ów. Wiesz coœ na ten temat?~
@76 = ~OdnaleŸliœmy biednego Bomarca wciœniêtego w œwie¿y grób razem z Raynardem, którego niedawno powiesili.~
@77 = ~Rozmawialiœmy ze stra¿nikami przy zachodniej bramie niedaleko „Drzewa wisielców”. Opowiedzieli nam o z³odzieju, Reynardzie, który zosta³ powieszony tydzieñ temu, ale nie wiedzieli zbyt wiele. Czekaliœmy, a¿ Ravella wróci na s³u¿bê, ¿eby z ni¹ porozmawiaæ. Mo¿e ona coœ wie.~
@78 = ~Us³yszeliœmy pog³oski, które zmuszaj¹ nas do bli¿szego przyjrzenia siê posiad³oœci Zahrdahla, tym razem dok³adniej ni¿ poprzednio.~
@79 = ~Oto, co siê sta³o, gdy zapytaliœmy Zahrdahla o dziennik.~
@80 = ~Pelltarze! Musimy porozmawiaæ!.~
@81 = ~Nie odkryliœmy ¿adnych rzeczy zwi¹zanych z kradzie¿ami czy morderstwami, za to natknêliœmy siê na informacje na temat pocz¹tkowych problemów, które niepokoi³y miasto.~
@82 = ~D³oñ chwa³y? Nie, nigdy wczeœniej nawet nie s³ysza³em o czymœ takim.~
@83 = ~Mo¿emy przejrzeæ twe ksiêgi? Mo¿e jedna z nich powie nam coœ na ten temat?~
@84 = ~Ksiêgi? Oczywiœcie! Dobra myœl. To mo¿e zaj¹æ wam chwilê. Ale proszê, nie k³opoczcie moich uczniów. Maj¹ swoje obowi¹zki.~
@85 = ~Trudne do odczytania, ale hmmm... To wygl¹da jak bardzo kiepsko narysowana mapa tego miasta. O ile dobrze rozumiem, ta linia oznacza rzekê, a to zapewne s¹ domy oraz sklepy. Czemu mia³yby s³u¿yæ te oznaczenia?~
@86 = ~Och! Na mi³osiern¹ Mystrê! Mam! Oznaczenia s¹ zaraz obok budynków, które zosta³y okradzione. Zobacz, te dwa tutaj to dwa magazyny, o których wspomina³ Gelpas. W trakcie twojej nieobecnoœci zamieni³em z nim kilka s³ów na temat reszty kradzie¿y. Pasuj¹ idealnie. IdŸ, porozmawiaj z Welcarem albo Zelmarem. S³ysza³em, ¿e równie¿ zosta³ okradziony. Pozosta³e znaki to pewnie domy.~
@87 = ~Dziwne. Po co zaznaczono latarniê? Bomarc jest praktycznie samotnikiem. Nie mia³by niczego wartego kradzie¿y. Symbol ró¿ni siê od innych, wiêc jest to pewnie punkt orientacyjny lub coœ podobnego.~
@88 = ~Tak czy inaczej, mo¿e powinniœmy sprawdziæ te¿ latarniê.~
@89 = ~Ju¿ byliœmy w latarni i za³atwiliœmy z³odzieja. Wygl¹da na to, ¿e ten bydlak zabi³ biednego Bomarca. Powiemy Pelltarowi o tym, co siê z nim sta³o.~
@90 = ~Mo¿e dlatego, ¿e z³odziej u¿ywa³ jej jako centrum operacyjnego?~
@91 = ~Szukajcie dalej. Gelpas nie pozwoli wam odejœæ, póki nie rozwi¹¿ecie tych problemów.~
@92 = ~Damy ci znaæ o wszystkim, co znajdziemy, jak tylko porozmawiamy z Ravell¹.~
@93 = ~Wiêc w³adcy znów zaczynaj¹? To jest najbardziej agresywna taktyka z dotychczas zastosowanych. Natychmiast powiadomiê Gelpasa oraz barona. Wyœwiadczy³aœ wielk¹ przys³ugê naszemu miastu.~ ~Wiêc w³adcy znów zaczynaj¹? To jest najbardziej agresywna taktyka z dotychczas zastosowanych. Natychmiast powiadomiê Gelpasa oraz barona. Wyœwiadczy³aœ wielk¹ przys³ugê naszemu miastu.~
@94 = ~Œwietnie. Mam nadziejê, ¿e to ju¿ wszystko. Muszê dokoñczyæ swoj¹ misjê na g³ównym l¹dzie.~
@95 = ~Dziêkujê. Wci¹¿ musimy wytropiæ nowych rabusiów na pó³noc od Resten i chcielibyœmy siê dowiedzieæ, co tak naprawdê sta³o siê Bomarcowi.~
@96 = ~Dziêkujê. Wci¹¿ musimy wytropiæ nowych rabusiów na pó³noc od Resten.~
@97 = ~Dziêkujê. Zanim odejdziemy, chcielibyœmy siê dowiedzieæ, co przydarzy³o siê Bomarcowi.~
@98 = ~Pójdziemy do latarni morskiej i zobaczymy, czy uda siê nam dopaœæ zabójcê Bomarca.~
@99 = ~Istotnie, nigdy nie bêdziemy w stanie dostatecznie wam podziêkowaæ. Wywo³am zaklêcie, by odes³aæ was z powrotem. Zatrzymam D³oñ Chwa³y. Moi uczniowie doceni¹ jej przydatnoœæ w trakcie nauki. Poniewa¿ oddzia³uje tylko na humanoidy, wyobra¿am sobie, ¿e by³aby bardzo u¿yteczna w rêkach takiego poszukiwacza przygód jak ty.~
@100 = ~Kana³y? Ach, system udro¿nieñ na wypadek poodzi. Tak, znajduj¹ siê na zachodniej czêœci miasta. Coœ siê tam wydarzy³o, jednak nie jestem w stanie sobie przypomnieæ, co to by³o. Hmm. Porozmawiaj z Welcarem, on zapewne bêdzie pamiêta³.~
@101 = ~Naprawdê nic? Dziwne, bior¹c pod uwagê te wszystkie pog³oski doko³a.~
@102 = ~I w³aœnie dlatego s¹ tylko pog³oskami, a nie faktami.~
@103 = ~Ach, wspaniale, Fabio ciê odnalaz³. Jak zapewne ju¿ ci wyt³umaczy³, mamy powa¿ny problem, którym, jak mi siê wydaje, tylko tacy poszukiwacze przygód jak wy mog¹ siê zaj¹æ.~
@104 = ~Znam kilka szczegó³ów, ale móg³byœ jeszcze raz to wszystko wyjaœniæ?~
@105 = ~Oczywiœcie. Yaltcie uda³o siê rzuciæ czar rozmowy ze zmar³ymi i wypytaliœmy Grellusa o wszystko, co pamiêta. Nie jest to niestety zbyt wiele. Sprawca uderzy³ w plecy i zabi³ go jednym ciosem. Nie widzia³, kim on by³.~
@106 = ~A co ze wskrzeszeniem go?~
@107 = ~Qualton jest jedynym kap³anem, który jest w stanie odprawiæ taki rytua³. Stwierdzi³, ¿e coœ blokuje ducha barona, tak wiêc nie jest w stanie go przywróciæ. W tej chwili cia³o barona jest prawdopodobnie zbyt posuniête w rozk³adzie, by cokolwiek z nim zrobiæ poza przemienieniem go w zombie. Sprawca zaatakowa³, kiedy nie by³o nikogo w pobli¿u, wiêc cia³o le¿a³o tak kilka godzin, zanim Fairwind odnalaz³a go rankiem.~
@108 = ~Jakieœ œlady?~
@109 = ~W³aœciwie tak. ZnaleŸliœmy w sypialni trzy przedmioty, które nie pochodz¹ st¹d. Z³ota struna le¿a³a pod ³ó¿kiem. Ma³y czerwony rubin wala³ siê obok zw³ok barona, natomiast w rêku trzyma³ on guzik z czerwonej skóry.~
@110 = ~Guzik? Ale powiedzia³eœ, ¿e nie widzia³ zabójcy?~
@111 = ~To jest ta dziwna czêœæ historii. Musia³ siê uczepiæ sprawcy, gdy umiera³, ale jego duch nie pamiêta³ niczego takiego. Mo¿liwe, ¿e sprawca nie wie o utracie guzika.~
@112 = ~Dodatkowo dowiedzieliœmy siê, ¿e trzech obcych wesz³o wczoraj do Brodu przez po³udniow¹ bramê. To jest brama zamykaj¹ca drogê prowadz¹c¹ w kierunku Garrotten.~
@113 = ~Opowiedz mi o ka¿dym z tych goœci.~
@114 = ~Pierwszym by³ stary cz³owiek o d³ugich bia³ych w³osach. Nosi³ on niebiesk¹ szatê z symbolem Osprem. Jad³ w tawernie Falco. Falco powiedzia³, i¿ cz³owiek ten nosi³ œwiêty symbol wieloryba o rubinowych oczach. Rozmiar tamtych rubinów zgadza siê z tym tutaj.~
@115 = ~Znam tego cz³owieka. To wysoki kap³an o imieniu Harper. Prowadzi œwi¹tyniê w Garrotten. Nie rozumiem, co robi³by tutaj bez ¿adnego ze swoich asystentów. Rzekomo by³ w mieœcie sam.~
@116 = ~Drugim by³ mê¿czyzna, który zatrzyma³ siê w tej samej tawernie kilka godzin póŸniej. Posiada³ lutniê, na której zagra³ kilka pieœni dla bywalców. Wedle relacji niektórych œwiadków lutnia ta mia³a z³ote struny.~
@117 = ~Ten zapewne jest bardem.~
@118 = ~Ostatni goœæ by³ wielkim, beczkowatym cz³owiekiem, który spotka³ siê z Zelmarem w Zachodnim wietrze. Chcia³ kupiæ kilka skrzynek wina. Przedstawi³ siê jako Abraham, st¹d te¿ wiem, ¿e jest on w³aœcicielem gospody w Garrotten. Nosi³ czerwon¹ kurtkê z tego samego koloru guzikami ze skóry.~
// Shall remain identical to @867 in baf.tra, otherwise there will be a journal issue
@119 = ~OdnajdŸ zabójcê barona Grellusa~
@120 = ~Twierdzisz, ¿e ci trzej mê¿czyŸni mogli zabiæ barona?~
@121 = ~Nie wiem, co mam myœleæ. Nie mogê uwierzyæ, ¿e ca³a trójka jest w to zamieszana. Z tego, co wiem, ¿aden z nich nie mia³ ¿adnego powodu, by go zabiæ. Jeden z nich musia³ to zrobiæ i pod³o¿y³ dowody przeciwko dwóm innym. W¹tpiê, aby zabójca zamierza³ cokolwiek po sobie zostawiæ.~
@122 = ~Wiêc wszystko, co muszê zrobiæ, to str¹ciæ parê ³epetyn z barków, a¿ jeden z nich zacznie gadaæ?~
@123 = ~Nie! Absolutnie nie! Niestety Garrotten jest pod opiek¹ Ksiêcia tak jak i my. Ka¿dy akt agresji wskazuj¹cy na udzia³ Brodu Resten móg³by sprowadziæ na nas wszystkich armiê ksiêcia.~ ~Nie! Absolutnie nie! Niestety Garrotten jest pod opiek¹ Ksiêcia tak jak i my. Ka¿dy akt agresji wskazuj¹cy na udzia³ Brodu Resten móg³by sprowadziæ na nas wszystkich armiê ksiêcia.~
@124 = ~W takim razie co proponujesz?~
@125 = ~Bêdziesz musia³ siê tam udaæ i zbadaæ tê sprawê tak, aby nikt nawet nie podejrzewa³, ¿e jesteœ tam na nasz¹ proœbê. Jeœli Lady Arrness dowie siê o tym, wyrzuci ciê z miasta albo, co gorsza, mo¿e kazaæ ciê zabiæ. Arrness jest tamtejsz¹ burmistrz. Œwiadom jestem jej niechêci do naszego miasta i wiem, ¿e z chêci¹ zobaczy³aby barona oraz jego rodzinê odsuniêtych od w³adzy. Mimo to nie wyobra¿am sobie, ¿eby bra³a udzia³ w tym procederze. Ksi¹¿ê urwa³by jej g³owê, jeœli dowiedzia³by siê, jakiego fermentu narobi³a na jego ziemiach. Ma wystarczaj¹co du¿o problemów z wojnami na granicy.~ ~Bêdziesz musia³a siê tam udaæ i zbadaæ tê sprawê tak, aby nikt nawet nie podejrzewa³, ¿e jesteœ tam na nasz¹ proœbê. Jeœli Lady Arrness dowie siê o tym, wyrzuci ciê z miasta albo, co gorsza, mo¿e kazaæ ciê zabiæ. Arrness jest tamtejsz¹ burmistrz. Œwiadom jestem jej niechêci do naszego miasta i wiem, ¿e z chêci¹ zobaczy³aby barona oraz jego rodzinê odsuniêtych od w³adzy. Mimo to nie wyobra¿am sobie, ¿eby bra³a udzia³ w tym procederze. Ksi¹¿ê urwa³by jej g³owê, jeœli dowiedzia³by siê, jakiego fermentu narobi³a na jego ziemiach. Ma wystarczaj¹co du¿o problemów z wojnami na granicy.~
@126 = ~Wiêc mam po prostu rozejrzeæ siê po mieœcie, dopóki czegoœ nie znajdê? To niezbyt pomocne.~
@127 = ~S³ysza³eœ plotki na temat Garrotten?~ ~S³ysza³aœ plotki na temat Garrotten?~
@128 = ~Jeœli chcesz siê kogoœ pozbyæ, idŸ do Garrotten. Tak, podobno dzia³a tam gildia zabójców.~
@129 = ~Nie ma ¿adnego dowodu na istnienie gildii. Musimy przyj¹æ, ¿e niektórzy mieszkañcy Garrotten s¹ istotnie dobrymi i przyzwoitymi ludŸmi.~
// Shall remain identical to @868 in baf.tra, otherwise there will be a journal issue
@130 = ~Tak wiêc mo¿na przypuszczaæ, ¿e ktoœ z miasta Garrotten jest zamieszany w zabójstwo barona Grellusa. Mam trzech podejrzanych: Harper - wysoki kap³an, Abraham - w³aœciciel gospody oraz Balmorrow, bard i w³aœciciel teatru. Dlaczego któryœ z nich mia³by zabiæ barona? Czy jeden z nich jest rzeczywiœcie wynajêtym zabójc¹? Jeœli tak, to który? I kto go wynaj¹³?~
@131 = ~Powiem ci jeszcze, ¿e jeœli uda ci siê znaleŸæ dowód na obecnoœæ gildii zabójców, pozb¹dŸ siê jej. Przynieœ mi tylko te dowody, abyœmy mogli usprawiedliwiæ siê przed Ksiêciem, a tak¿e Lady Fairwind, jako ¿e ona jest teraz w³adczyni¹ Brodu Resten. Zniszczenie tak z³owieszczego stowarzyszenia uczyni³oby te burzliwe czasy znacznie bezpieczniejszymi dla wszystkich dobrych ludzi. Ksi¹¿ê ¿yczy³by sobie, aby ka¿de takie stowarzyszenie zosta³o zniszczone. Jeœli Arness ukrywa istnienie gildii, otrzyma tak¹ karê, jak¹ jej wymierzysz.~
// Shall remain identical to @869 in baf.tra, otherwise there will be a journal issue
@132 = ~Gildia zabójców

Upewnij siê, czy pog³oski na temat gildii zabójców w mieœcie Garrotten s¹ prawdziwe.~
@133 = ~Opacie Qualton, twoje czyny s¹ niewybaczalne. Baronowa zadecyduje o twym dalszym losie. Stra¿e, zabraæ go st¹d.~
@134 = ~<CHARNAME>, Nie wiem jak ci dziêkowaæ. Wiem, ¿e Qualton prowadzi³ kilka miesiêcy temu walkê z po¿eraczem intelektu. Zastanawiam siê, czy to stworzenie by³o przyczyn¹ jego zachowania.~
@135 = ~Byæ mo¿e. Spotyka³em ju¿ innych ludzi z problemami umys³owymi. ¯aden nie wydawa³ siê tak pokrêcony.~
@136 = ~W ka¿dym razie chyba jesteœcie ju¿ gotowi do powrotu? Zdajê sobie sprawê, ¿e masz swoje w³asne sprawy do rozwi¹zania, czy¿ nie, Dzieciê Bhaala?~
@137 = ~Wiesz coœ o moim pochodzeniu? Odnoszê wra¿enie, ¿e wszyscy dooko³a zdaj¹ siê wiedzieæ o mnie wiêcej ni¿ ja sam... *westchnienie* Tak, muszê powstrzymaæ Sarevoka.~ ~Wiesz coœ o moim pochodzeniu? Odnoszê wra¿enie, ¿e wszyscy dooko³a zdaj¹ siê wiedzieæ o mnie wiêcej ni¿ ja sama... *westchnienie* Tak, muszê powstrzymaæ Sarevoka.~
@138 = ~Rozumiem. Wyœlê was zaraz w okolice Wrót Baldura. Musisz wiedzieæ, ¿e pewnie ju¿ ciê uznali za uciekiniera. Trzymaj siê z dala od stra¿ników P³omiennej Piêœci i powodzenia.~
@139 = ~Witaj, <CHARNAME>. Jakie informacje uda³o ci siê zdobyæ?~
@140 = ~ZnaleŸliœmy ten oto list od Qualtona to Tellisha. Opat zatrudni³ go, by zabi³ barona.~
@141 = ~Qualton zaatakowa³ nas w chwili, gdy pokazaliœmy mu list. Zacz¹³ bredziæ, zupe³nie jak gdyby by³y w nim dwie osoby. Jeden g³os mówi³, ¿eby nas zabiæ, drugi siê opiera³. Wspomnia³ te¿ coœ o poœlubieniu Andrelli i ¿e zamierza zabiæ Ksiêcia.~
@142 = ~Gildia zabójców jest ju¿ histori¹. Znalaz³em te oto dokumenty w pokoju pani burmistrz. Zawieraj¹ wszystkie potrzebne nam informacje: czyja robota, kto p³aci³ i kto zosta³ zabity. S¹ tu tak¿e informacje o szpiegach porozsy³anych po wyspach.~ ~Gildia zabójców jest ju¿ histori¹. Znalaz³am te oto dokumenty w pokoju pani burmistrz. Zawieraj¹ wszystkie potrzebne nam informacje: czyja robota, kto p³aci³ i kto zosta³ zabity. S¹ tu tak¿e informacje o szpiegach porozsy³anych po wyspach.~
@143 = ~Jak dot¹d nic.~
@144 = ~Burmistrz nas ubieg³a. Zaaresztowa³a naszych trzech podejrzanych i oœwiadczy³a, ¿e Abraham, w³aœciciel gospody, przyzna³ siê do stawianych mu zarzutów. On, Balmorrow oraz Harper byli czêœci¹ gildii.~
@145 = ~Co? Niemo¿liwe! Przecie¿ stoi na czele tutejszego koœcio³a. To œwiêty cz³owiek. Musia³a zajœæ jakaœ pomy³ka.~
@146 = ~Przeczytaj to sobie. Znasz jego styl pisma lepiej ni¿ ja. Tak czy inaczej, to bez znaczenia. Stan¹³em z nim ju¿ twarz¹ w twarz, a on zaatakowa³. Qualton jest martwy.~ ~Przeczytaj to sobie. Znasz jego styl pisma lepiej ni¿ ja. Tak czy inaczej, to bez znaczenia. Stanê³am z nim ju¿ twarz¹ w twarz, a on zaatakowa³. Qualton jest martwy.~
@147 = ~Przeczytaj to sobie. Znasz jego styl pisma lepiej ni¿ ja.~
@148 = ~Hmm, to jego pismo. W porz¹dku, porozmawiaj z nim. Zobaczymy, czy siê przyzna.~
@149 = ~Hmm, to jego pismo. S¹dzê, ¿e na tê chwilê to nieistotne. Wiêc Qualton chcia³ œmierci barona? Powiedzia³ dlaczego?~
@150 = ~Zacz¹³ bredziæ, zupe³nie jak gdyby by³y w nim dwie osoby. Jeden g³os mówi³, ¿eby zabiæ, drugi siê opiera³. Wspomnia³ te¿ coœ o poœlubieniu Andrelli i ¿e zamierza zabiæ Ksiêcia.~
@151 = ~Dwie osoby? Jakiœ czas temu dowodzi³ bitw¹ z ³upie¿cami umys³u, którzy jakimœ cudem do nas przycumowali. Zastanawia mnie, czy to nie w³aœnie ³upie¿ca dokona³ spustoszenia w jego g³owie. Od tamtego czasu dziwnie siê zachowywa³. Nigdy bym siê tego po nim nie spodziewa³.~
@152 = ~Móg³byœ sprawdziæ tê gildiê. Spróbuj kogoœ wynaj¹æ, by zbadaæ panuj¹c¹ w tej grupie hierarchiê. Móg³byœ siê równie¿ dowiedzieæ, czy ta trójka podejrzanych faktycznie jest niewinna i sprawdziæ, co maj¹ do powiedzenia w tej sprawie. Oni tam mieszkaj¹, wiêc przynajmniej jeden z nich powinien ci pomóc. Bêdziesz musia³ zwracaæ szczególn¹ uwagê na to, co mówisz i robisz.~ ~Mog³abyœ sprawdziæ tê gildiê. Spróbuj kogoœ wynaj¹æ, by zbadaæ panuj¹c¹ w tej grupie hierarchiê. Mog³abyœ siê równie¿ dowiedzieæ, czy ta trójka podejrzanych faktycznie jest niewinna i sprawdziæ, co maj¹ do powiedzenia w tej sprawie. Oni tam mieszkaj¹, wiêc przynajmniej jeden z nich powinien ci pomóc. Bêdziesz musia³a zwracaæ szczególn¹ uwagê na to, co mówisz i robisz.~
@153 = ~Droga do Garrotten prowadzi przez po³udniow¹ bramê. Powinno zaj¹c ci jakiœ dzieñ, zanim tam dotrzesz. Przeniós³bym was na miejsce, jednak nigdy wczeœniej tam nie by³em. Przenoszenie kogoœ na nieznany teren mo¿e mieæ katastrofalne skutki. Zna³em takich czarowników, którzy zmaterializowali pasa¿erów wewn¹trz ska³y czy drzewa. Upewnij siê, ¿e masz wszystkie zapasy, jakie bêd¹ ci potrzebne. Nie wiem, jak dobrze tamtejsze sklepy s¹ zaopatrzone w mikstury czy magiczne przedmioty. Kiedy wrócisz, udaj siê wprost do mnie, abyœmy mogli poinformowaæ baronow¹ o sytuacji. W miêdzyczasie udam siê sprawdziæ, jak radzi sobie rodzina.~
@154 = ~Wiêc gildia faktycznie istnia³a, a pani burmistrz sta³a na jej czele? To ma sens, zabójcy nie mogli prowadziæ dzia³alnoœci bez jej wiedzy. Zak³adam, ¿e usun¹³eœ ka¿dego cz³onka, jaki stan¹³ na twej drodze?~ ~Wiêc gildia faktycznie istnia³a, a pani burmistrz sta³a na jej czele? To ma sens, zabójcy nie mogli prowadziæ dzia³alnoœci bez jej wiedzy. Zak³adam, ¿e usunê³aœ ka¿dego cz³onka, jaki stan¹³ na twej drodze?~
@155 = ~Ale¿ tak, walka z jej stra¿¹ by³¹ ciê¿ka, ale daliœmy radê.~
@156 = ~Dobra robota. Teraz potrzebujê tylko informacji, dlaczego ktoœ chcia³ œmierci barona.~
@157 = ~Wróæ do mnie, gdy tylko odnajdziesz dowód na istnienie gildii i ustalisz powód œmierci barona.~
@158 = ~<CHARNAME>! Mystrze niech bêd¹ dziêki, znalaz³em ciê.~
@159 = ~Pelltar? Co Ty tu robisz?~
@160 = ~Raz jeszcze potrzebujê twej pomocy. Baron zosta³ zamordowany! To siê sta³o zesz³ej nocy. Zarówno Yalta, jak i Qualton nie potrafili œci¹gn¹æ go z powrotem. Potrzebujemy twej pomocy.~
@161 = ~Co takiego!? Powiedz wszystko, co wiesz.~
@162 = ~I powodem, dla którego mia³bym siê tym przej¹æ, jest...?~ ~I powodem, dla którego mia³abym siê tym przej¹æ, jest...?~
@163 = ~Och, wiêc ocalenie Brodu Resten by³o dla ciebie wystarczaj¹ce? Ju¿ ciê to nie obchodzi? Billy Bob wspomina³, ¿e mo¿e do tego dojœæ.~
@164 = ~Twoje miasto by³o wrzodem na ty³ku, o którym chcê jak najszybciej zapomnieæ. Zostaw mnie, znajdŸ sobie innego g³upca.~
@165 = ~S³uchaj, wspó³czujê, ale w³aœnie uciek³em z wiêzienia. Stra¿e twierdz¹, ¿e przez pomy³kê zabi³em kogoœ, kto by³ sprawc¹ zamêtu na Wybrze¿u Mieczy. Jestem teraz trochê nabuzowany i muszê doprowadziæ tê sprawê do koñca.~ ~S³uchaj, wspó³czujê, ale w³aœnie uciek³am z wiêzienia. Stra¿e twierdz¹, ¿e przez pomy³kê zabi³am kogoœ, kto by³ sprawc¹ zamêtu na Wybrze¿u Mieczy. Jestem teraz trochê nabuzowana i muszê doprowadziæ tê sprawê do koñca.~
@166 = ~Niech i tak bêdzie.~
@167 = ~¯adna osoba na wyspach Lendore nie dowie siê o tym, wiêc powinieneœ byæ tam bezpieczny. Porozmawiam z Lady Fairwind i zobaczymy, czy mo¿emy jakoœ ci pomóc. W miêdzyczasie jednak jesteœ nam potrzebny.~ ~¯adna osoba na wyspach Lendore nie dowie siê o tym, wiêc powinnaœ byæ tam bezpieczna. Porozmawiam z Lady Fairwind i zobaczymy, czy mo¿emy jakoœ ci pomóc. W miêdzyczasie jednak jesteœ nam potrzebna.~
@168 = ~Dobrze, pomogê. Powiedz mi, co wiesz.~
@169 = ~Nie, naprawdê muszê sobie pouk³adaæ sprawy. Nie mogê wam pomóc.~
@170 = ~Jedyne co wiemy, to to, ¿e nie widzia³ zabójcy. Nikt nie wie, czy reszta rodziny powinna czuæ siê zagro¿ona, czy te¿ by³ to pojedynczy atak.~
@171 = ~Mogê nas wszystkich przenieœæ do Resten. Pomo¿esz?~
@172 = ~Œwietnie, dotarliœmy. Ta sprawa jest powa¿na i chyba tylko tacy poszukiwacze przygód jak wy potrafi¹ sobie z ni¹ poradziæ.~
@173 = ~Czy móg³byœ zacz¹æ wszystko od pocz¹tku?~
@174 = ~Abraham przyzna³ siê, ¿e zabi³ barona? Kiedy wam to powiedzia³.~
@175 = ~Chwilê przed tym, zanim wyruszyliœmy w drogê do Brodu Resten. Dlaczego?~
@176 = ~Poniewa¿ zesz³ej nocy ktoœ zabi³ Lady Fairwind!~
@177 = ~Co? Ale¿ to nie mo¿liwe. Wszyscy trzej podejrzani s¹ w tej chwili w wiezieniu.~
@178 = ~Có¿, wygl¹da na to, ¿e jest wiêcej cz³onków gildii. Nie pozby³eœ siê wszystkich. Wróæ do Garrotten i dowiedz siê, kto jeszcze jest w to zamieszany.~ ~Có¿, wygl¹da na to, ¿e jest wiêcej cz³onków gildii. Nie pozby³aœ siê wszystkich. Wróæ do Garrotten i dowiedz siê, kto jeszcze jest w to zamieszany.~
@179 = ~Wystawieni do wiatru

Areness pojma³a trzech podejrzanych, ale w mieœcie jest wiêcej cz³onków gildii. Ktoœ zabi³ Lady Fairwind. Powinienem by³ siê dowiedzieæ wiêcej w Garrotten.~ ~Wystawieni do wiatru

Areness pojma³a trzech podejrzanych, ale w mieœcie jest wiêcej cz³onków gildii. Ktoœ zabi³ Lady Fairwind. Powinnam by³a siê dowiedzieæ wiêcej w Garrotten.~
@180 = ~Tak? Potrzebujesz jeszcze czegoœ?~
@181 = ~Móg³byœ mi powiedzieæ raz jeszcze, co mam zrobiæ?~
@182 = ~Oczywiœcie. Dowiedz siê, kto zabi³ barona. Jeœli zabójca jest cz³onkiem gildii, znajdŸ dowód na jej istnienie i zniszcz j¹. Chcê równie¿ wiedzieæ, kto zatrudni³ zabójcê.~
@183 = ~Proszê, opowiedz mi wszystko, <CHARNAME>. By³eœ w stanie zrobiæ to, do czego siê zobligowa³eœ?~ ~Proszê, opowiedz mi wszystko, <CHARNAME>. By³aœ w stanie zrobiæ to, do czego siê zobligowa³aœ?~
@184 = ~Gdyby tylko istnia³ sposób na pozbycie siê gildii zabójców w Garrotten.~
@185 = ~Dobra robota.~
@186 = ~£a³, jesteœmy na wyspie! Spodziewa³eœ siê, ¿e bêdziemy tak du¿o podró¿owaæ? Co powinniœmy zrobiæ najpierw?~ ~£a³, jesteœmy na wyspie! Spodziewa³aœ siê, ¿e bêdziemy tak du¿o podró¿owaæ? Co powinniœmy zrobiæ najpierw?~
@187 = ~Iœæ wylegiwaæ siê na pla¿y? Nie wiem. Mo¿e powinniœmy zacz¹æ od rozmowy z tutejszymi mieszkañcami i dowiedzieæ siê, co tu siê tak naprawdê dzieje.~
