@1 = ~Masz odwagê, ¿eby tu przychodziæ? Kupo stêch³ego miêsa?!~
@2 = ~Powinienem ciê wybebeszyæ i pozwoliæ ci ¿yæ na tyle d³ugo, byœ móg³ to ogl¹daæ.~
@3 = ~Haha! Stary dobry Fabio! Ha. Co sprowadza ciê do naszego wspania³ego miasta? Czy¿by zabrak³o ci owieczek i kobiet w Brodzie Resten?~
@4 = ~Zdaje siê, ¿e twój przyjaciel pracuje nad srebrn¹ mow¹ podobnie jak ty, Fabio. Mam tylko nadziejê, ¿e nie spowoduje to ¿adnych k³opotów, z których nie zawsze potrafisz siê wypl¹taæ.~
@5 = ~Hmm? Nie mowa prawdziwego barda, jak mniemam. Niewa¿ne.~
@6 = ~Przyjaciele, czy bylibyœcie ³askawi zrobiæ sobie ma³a przerwê i daæ nam chwilê czasu? Dziêkujê.~
@7 = ~Przykro mi bardzo, ale w³aœnie zamykamy. Zechciejcie przyjœæ jutro. Przedstawienie zacznie siê o brzasku.~
@8 = ~Tyœ jest Balmorrow?~
@9 = ~*k³ania siê* To ja. Coœ jeszcze?~
@10 = ~Musimy zamieniæ miêdzy sob¹ kilka s³ów.~
@11 = ~W tej chwili jestem poch³oniêty przygotowaniem sceny. Nie mog³oby to poczekaæ do jutra rana?~
@12 = ~Oczywiœcie.~
@13 = ~Fabio poleci³ mi rozmowê z tob¹.~
@14 = ~Musimy pomówiæ teraz. Jesteœ oskar¿ony o dokonanie zabójstwa na baronie Grellusie.~
@15 = ~Fabio? Dobrzy bogowie, w co wpakowa³ siê TYM razem? Córka arystokraty? D³ugi z hazardu?~
@16 = ~Nic z tych rzeczy. Jednak¿e naprawdê musimy w tej chwili z tob¹ porozmawiaæ.~
@17 = ~*wzdycha* A wiêc dobrze.~
@18 = ~Co takiego? Morderstwo? To wcale nie jest zabawne, m³ody panie. Nie odwiedza³em Brodu Resten od wielu lat. W¹tpiê tak¿e, ¿eby baron mnie kiedykolwiek odwiedzi³.~ ~Co takiego? Morderstwo? To wcale nie jest zabawne, m³oda pani. Nie odwiedza³em Brodu Resten od wielu lat. W¹tpiê tak¿e, ¿eby baron mnie kiedykolwiek odwiedzi³.~
@19 = ~A teraz poszukaj sobie kogoœ innego do zabawy. Mam robotê do zrobienia. Willis, upewnij siê, ¿e ci g³upcy trafi¹ do wyjœcia. Natomiast ty, Phyllis, z pewnoœci¹ bêdziesz chcia³a sprawdziæ, czy odwiedz¹ stra¿.~
@20 = ~Obok cia³a barona znaleziono tê z³ota strunê z lutni. Kilkoro ludzi z karczmy twierdzi, ¿e widzieli twoje przedstawienie tamtej nocy. Zechcia³byœ siê do tego ustosunkowaæ?~
@21 = ~W porz¹dku, zamieniam siê w s³uch. O czym to ¿yczysz sobie ze mn¹ rozmawiaæ?~
@22 = ~Gdzie by³em dwie noce temu?~
@23 = ~S³ucham? Có¿, przebywa³em w mojej sypialni. Dlaczego pytasz?~
@24 = ~Masz mo¿e na to jakiœ dowód? Móg³by ktoœ potwierdziæ twoje s³owa?~
@25 = ~Jestem w trakcie pisania nowej sztuki. Nie jestem w stanie pisaæ, kiedy ktoœ krêci siê wokó³ mnie i zawraca mi g³owê. Tak wiêc by³em sam. Pytam ponownie, dlaczego ciê to interesuje?~
@26 = ~Dwie noce temu widziano ciê w tawernie w Brodzie Resten.~
@27 = ~Bród Resten? Od lat tam nie by³em. To z pewnoœci¹ nie by³em ja.~
@28 = ~Osoba ta utrzymywa³a, i¿ jest tob¹. Nawet wyst¹pi³a, u¿ywaj¹c lutni ze z³otymi strunami.~
@29 = ~To nie by³em ja. Lutnie, nawet te ze z³otymi strunami, mo¿na znaleŸæ wszêdzie.~
@30 = ~W ka¿dym razie nie wyjaœnia to zainteresowania moj¹ osob¹ czy te¿ miejscem mojego pobytu.~
@31 = ~Tamtej nocy ktoœ zamordowa³ Grellusa, barona Brodu Resten. Niedaleko jego zw³ok znaleziono z³ota strunê.~
@32 = ~Co takiego? Baron nie ¿yje? Zaczekaj chwilê. Myœlisz, ¿e to ja zrobi³em? Niebywa³e!~
@33 = ~Bez wzglêdu na to, czy to zrobi³eœ, czy te¿ nie, jesteœ podejrzanym w tej sprawie.~
@34 = ~Na Osprem i Maska razem wziêtych. Nie mia³em z tym nic wspólnego. Cholera! Nawet nie mam jak ci tego udowodniæ. Ale zaczekaj. Masz przy sobie tê strunê?~
@35 = ~Tak, proszê.~
@36 = ~Niestety nie przynieœliœmy jej.~
@37 = ~Moje struny s¹ wykonywane na specjalne zamówienie przez rzemieœlników z Calimportu. To nie s¹ zwyk³e struny o z³otym kolorze.~
@38 = ~Niech to szlag! To moja struna. Jak to mo¿liwe?~
@39 = ~Doœæ gadania. Jesteœ oskar¿ony o morderstwo i pójdziesz teraz z nami.~
@40 = ~Jest w tym mieœcie ktoœ, kto móg³by ciê w to wrobiæ? Mo¿e cz³onek twojej trupy?~
@41 = ~Jesteœ g³upcem! Nie mogê uwierzyæ, jakim cudem wys³ali takiego idiotê na dochodzenie. Wszak¿e oczywiste jest, ¿e baron zosta³ zamordowany przez tutejsz¹ gildiê zabójców.~ ~Zwariowa³aœ! Nie mogê uwierzyæ, jakim cudem wys³ali tak¹ idiotkê na dochodzenie. Wszak¿e oczywiste jest, ¿e baron zosta³ zamordowany przez tutejsz¹ gildiê zabójców.~
@42 = ~A wiêc taka organizacja jednak istnieje. Kim s¹ jej przywódcy?~
@43 = ~Jeszcze do tego nie doszed³em. Wiem natomiast, ¿e dwoje cz³onków przesiaduje wewn¹trz gospody. Oskar i Philmar, obaj pracuj¹ dla kogoœ. Problem w tym, ¿e nie wiem, kim ta osoba jest.~
// Shall remain identical to @888 in baf.tra, otherwise there will be a journal issue
@44 = ~Balmorrow w gospodzie wskaza³ Philmara oraz Oskara jako cz³onków gildii zabójców. Muszê siê upewniæ, czy aby na pewno jestem w ich obecnoœci bezpieczny.~ ~Balmorrow w gospodzie wskaza³ Philmara oraz Oskara jako cz³onków gildii zabójców. Muszê siê upewniæ, czy aby na pewno jestem w ich obecnoœci bezpieczna.~
@45 = ~Tamta dwójka? Czy którykolwiek z nich mia³by dostêp do twojej lutni?~
@46 = ~Tutaj? Nie, nie. Jednak w tej sprawie zwróci³bym uwagê na dzia³alnoœæ ich gildii.~
@47 = ~Nie, niemo¿liwe. Zostawiam j¹ w biurze. Wilbur w zesz³ym tygodniu zerwa³ strunê, wiêc musia³em nawin¹æ now¹. Struna, w posiadaniu której jesteœ, równie¿ jest zepsuta. Nie mam pojêcia, sk¹d siê wziê³a.~
@48 = ~Wilbur? Mo¿e powinniœmy zamieniæ z nim kilka s³ów na ten temat.~
@49 = ~Och, jest lojalnym pracownikiem. Nie móg³ byæ w to zamieszany. Jednak¿e sprowadzê go.~
@50 = ~Holga jest w s³u¿bie Lady Arrness.~
@51 = ~Dlaczego chcia³by j¹ mieæ?~
@52 = ~Dobre pytanie. Wilbur, czy wypytywa³a ciê o strunê?~
@53 = ~<CHARNAME>! Nie mów do niego w ten sposób! Nie przejmuj siê, Wilbur. Wszystko w porz¹dku. Mo¿esz odejœæ.~
@54 = ~Mo¿esz nie mieæ na tyle czasu. Holga z pewnoœci¹ nale¿y do gildii. Jeœli dowie siê, ¿e zada³eœ te pytania, nie omieszka powiadomiæ o tym resztê.~ ~Mo¿esz nie mieæ na tyle czasu. Holga z pewnoœci¹ nale¿y do gildii. Jeœli dowie siê, ¿e zada³aœ te pytania, nie omieszka powiadomiæ o tym resztê.~
@55 = ~Wyjaœnij, kim jest Holga i dlaczego siê z nim kontaktuje?~
@56 = ~Wilbur mo¿e i nie jest najostrzejszym sztyletem, ale to dobry ch³opiec. Holga pracuje dla Arrness. Jeœli nie wiesz, Arrness jest czarodziejk¹, a poza tym sprawuje w³adzê w tym miejscu. Holga jest m³od¹ gosposi¹ chc¹c¹ nauczyæ siê sztuki magicznej. Czêsto siê tutaj pojawia.~
@57 = ~*marszczy brwi* Hmm, jeœli pracuje dla zabójców, kreci siê tutaj, by mnie szpiegowaæ. Wilbur jest ³atwowierny. Za³o¿ê siê, i¿ oczarowa³a go, by czu³ do niej sympatiê. Czemu tego nie dostrzeg³em? Chyba powinienem byæ wdziêczny, ¿e gildia nie wbi³a mi no¿a w plecy.~
// Shall remain identical to @887 in baf.tra, otherwise there will be a journal issue
@58 = ~Balmorrow jest obserwowany przez Holgê. Ona natomiast pracuje dla burmistrz Arrness. Czy¿by burmistrz by³a przywódczyni¹ zabójców?~
@59 = ~*trzymasz jego lutniê* Mo¿e jednak.~
@60 = ~Z jakiego powodu mieliby mnie wrabiaæ? Mo¿na by s¹dziæ, i¿ jest wielu innych ludzi, którzy mogliby byæ im bardziej nie w smak.~
@61 = ~Skoro ju¿ o tym mowa, tamtejszej nocy w Resten nocowa³o trzech goœci z Garrotten.~
@62 = ~Podejrzewam, ¿e osoba podaj¹ca siê za mnie by³a jednym z nich. Kim s¹ dwaj pozostali?~
@63 = ~Harper i Abraham. To jeszcze nie koniec, ca³a trójka pozostawi³a coœ na miejscu zdarzenia.~
@64 = ~*œmieje siê* Tego ju¿ za wiele! Harper? Niemo¿liwe! Widzia³eœ siê z nim?~ ~*œmieje siê* Tego ju¿ za wiele! Harper? Niemo¿liwe! Widzia³aœ siê z nim?~
@65 = ~Tak. Odbi³o mu ca³kowicie.~
@66 = ~Jeszcze nie.~
@67 = ~Jest ju¿ stary, a jego umys³ ju¿ dawno go opuœci³. Nie ma takiej mo¿liwoœci, aby podj¹³ siê podró¿y do Brodu Resten. Tym bardziej nie zabi³by barona lub kogokolwiek innego.~
@68 = ~Ko³o cia³a barona znaleziono ma³y rubin. Harper lub ktoœ, kto ubiera siê podobnie, by³ widziany w tamtejszej gospodzie, a na szyi nosi³ naszyjnik wysadzany rubinami.~
@69 = ~Wszak to œwiêty symbol Osprem. Rubiny przedstawiaj¹ oczy wieloryba. Ka¿dy ogl¹da ten symbol na jego szyi, kiedy ten odprawia msze.~
@70 = ~A wiêc wygl¹d amuletu jest powszechnie znany? To oznacza, ¿e ktokolwiek móg³by zrobiæ jego replikê.~
@71 = ~Rozmawiasz z w³aœcicielem teatru. Ca³y czas wykonujemy kostiumy oraz rekwizyty. Ka¿dy móg³by to zrobiæ. Ka¿dy, kto ma dostêp do sporej iloœci z³ota i kamieni szlachetnych. Wasz „Harper” nie nale¿y do biednych rolników. To ktoœ, kto posiada dostêp do sporej iloœci pieniêdzy.~
@72 = ~Zaprawdê interesuj¹ce. Ostatni¹ osob¹ by³ Abraham, a w d³oni Grellusa znaleziono czerwony guzik.~
@73 = ~Kurtka Abrahama. Zawsze ma j¹ za³o¿on¹, gdziekolwiek nie pójdzie. Przysi¹g³bym, ¿e jest magiczna. Nie spotkasz go bez niej.~
@74 = ~Ju¿ dowiedzia³em siê o jego zaginionym guziku.~ ~Ju¿ dowiedzia³am siê o jego zaginionym guziku.~
@75 = ~Bêdê siê musia³ przyjrzeæ jego kurtce. Jeszcze siê z nim nie widzia³em.~ ~Bêdê siê musia³a przyjrzeæ jego kurtce. Jeszcze siê z nim nie widzia³am.~
@76 = ~Jestem przekonany, ¿e brakuje w niej guzika. Nie by³bym zaskoczony, gdyby w amulecie Harpera brakowa³o rubinu. Gildia dokona³a wszelkich starañ, abyœmy wygl¹dali na winnych.~
@77 = ~Nie zdziwi³by mnie brakuj¹cy rubin w œwiêtym amulecie Harpera. Oczywiœcie gildia dokona³a wszelkich starañ, abyœmy wygl¹dali na winnych.~
@78 = ~Oto jest sprawa, w której mogê ci pomóc. Harper, Abraham oraz ja, wszyscy wiemy o zabójcach w naszym mieœcie. Ufamy sobie nawzajem oraz innemu przyjacielowi, Martinowi. Jest druidem zamieszkuj¹cym to miasto. Podejrzewam, ¿e ka¿dy z nas ma przy sobie szpiega, albo dwóch.~
@79 = ~Dlaczego nie próbowaliœcie powstrzymaæ gildii?~
@80 = ~Poniewa¿ wiemy, ¿e taka organizacja istnieje, ale nie mamy pojêcia, kim s¹ jej przywódcy. ¯aden z nas nie chcia³by zostaæ zabitym podczas snu. Ka¿dy z nas pilnuje pozosta³ych, ale to wszystko, co jesteœmy w stanie zrobiæ.~
@81 = ~Wiêc pozwoliliœcie im biegaæ swobodnie?~
@82 = ~Wiêc ¿aden z was nie ma ikry?~
@83 = ~Hej! Niektórzy z nas maj¹ rodziny. Wszyscy mamy przyjació³, którzy potrzebuj¹ naszej ochrony. Nie znaj¹c osoby im przewodz¹cej, nie mogliœmy nic zrobiæ.~
@84 = ~Pozwól zatem mnie siê tym zaj¹æ.~
@85 = ~Z radoœci¹. Tylko miej oczy z ty³u g³owy. Sugerujê, abyœ uda³ siê do gospody i zobaczy³, czego mo¿esz siê tam dowiedzieæ. Powinieneœ równie¿ zajrzeæ do œwi¹tyni. Z pewnoœci¹ kreci siê tam szpieg.~ ~Z radoœci¹. Tylko miej oczy z ty³u g³owy. Sugerujê, abyœ uda³a siê do gospody i zobaczy³a, czego mo¿esz siê tam dowiedzieæ. Powinnaœ równie¿ zajrzeæ do œwi¹tyni. Z pewnoœci¹ kreci siê tam szpieg.~
@86 = ~Ostatnia rzecz. Jeœli stra¿nicy albo ktokolwiek z zamku dowiedz¹ siê o celu twojego pobytu tutaj, mo¿esz zostaæ szybko namierzony i usuniêty. Któ¿ mo¿e wiedzieæ, kto jest cz³onkiem frakcji? Wiêc nie pozwól, aby ktokolwiek inny oprócz Abrahama wiedzia³ o celu twej wizyty.~
@87 = ~Na bogów, mówisz powa¿nie. Có¿, hmm, nie, nie jestem w stanie wyjaœniæ czegokolwiek. Od lat nie by³em w Resten. Nie jestem morderc¹ i nie mam z tym nic wspólnego.~
@88 = ~Jak mo¿na zauwa¿yæ, Wilbur nie jest najostrzejszym no¿em w szufladzie. Jednak¿e jest dobrym ch³opcem i lojalnym pracownikiem. Chcia³bym wiedzieæ, jakim cudem dorwali siê do mojej struny.~
@89 = ~Ktoœ z gildii ciê wrobi³.~
@90 = ~<CHARNAME>, mój bohaterze! Proszê, wyci¹gnij mnie st¹d.~ ~<CHARNAME>, moja zbawicielko! Proszê, wyci¹gnij mnie st¹d.~
@91 = ~Daj mi chwilkê.~
@92 = ~Bez obaw, mo¿esz spokojnie kierowaæ siê do wyjœcia. Oczyœci³em drogê ze stra¿ników.~ ~Bez obaw, mo¿esz spokojnie kierowaæ siê do wyjœcia. Oczyœci³am drogê ze stra¿ników.~
@93 = ~<CHARNAME>, widzia³eœ mo¿e Wilbura?~ ~<CHARNAME>, widzia³aœ mo¿e Wilbura?~
@94 = ~Nie.~
@95 = ~*marszczy brwi* To dziwne. Mia³ tu byæ, by zanieœæ te szaty do czyszczenia.~
@96 = ~To niemo¿liwe, Holga by³a sierot¹.~
@97 = ~Coœ siê wydarzy³o. <CHARNAME>, rozmawia³eœ z Holg¹ na temat struny?~ ~Coœ siê wydarzy³o. <CHARNAME>, rozmawia³aœ z Holg¹ na temat struny?~
@98 = ~Oczywiœcie. Powiedzia³em jej o k³opotach, jakie spad³y na Wilbura za to, w co go wpakowa³a.~ ~Oczywiœcie. Powiedzia³am jej o k³opotach, jakie spad³y na Wilbura za to, w co go wpakowa³a.~
@99 = ~Gdyby jej na nim nie zale¿a³o, mog³a pozwoliæ na jego schwytanie. Hmm.~
@100 = ~Na Maska! Musia³a zabraæ go gdzieœ, by mogli uciec. Oni uciekaj¹! Póki nie skieruj¹ siê do Brodu Resten, nie ma innego miejsca w okolicach, które by³oby dla tej dwójki bezpieczne. W tych czasach orkowie wydaj¹ siê byæ wszêdzie.~
@101 = ~Jeœli masz czas, móg³byœ ich poszukaæ?~ ~Jeœli masz czas, mog³abyœ ich poszukaæ?~
@102 = ~Nie jestem pewny, w tej chwili œledztwo w sprawie morderstwa jest wa¿niejsze.~ ~Nie jestem pewna, w tej chwili œledztwo w sprawie morderstwa jest wa¿niejsze.~
@103 = ~Jasne, poszukam ich.~
@104 = ~Co? Czemu¿ to mia³bym siê przejmowaæ t¹ dwójk¹ g³upich dzieciaków? Niech orkowie siê nimi zajm¹.~ ~Co? Czemu¿ to mia³abym siê przejmowaæ t¹ dwójk¹ g³upich dzieciaków? Niech orkowie siê nimi zajm¹.~
@105 = ~*k³ania siê* Rozumiem. Miejmy nadziejê, ¿e dadz¹ sobie radê.~
@106 = ~Dziêkujê.~
@107 = ~Zgodzê siê z tob¹, i¿ sami s¹ sobie winni, ale to gildia jest przede wszystkim odpowiedzialna za ca³e to zamieszanie. Mimo wszystko proszê ciê. Wilbur jest dobrym ch³opcem i lojalnym pomocnikiem. OdnajdŸ ich, jeœli mo¿esz.~
@108 = ~Jak to dobrze, byæ znów wolnym. Jeszcze raz dziêkujê. Wiêc gildia zabójców zosta³a unicestwiona?~
@109 = ~Tak, znalaz³em dokumenty œwiadcz¹ce o przywództwie pani burmistrz nad zabójcami. Tellish równie¿ by³ w to zamieszany.~
@110 = ~Nie, jeszcze nie znalaz³em prawdziwych dowodów.~ ~Nie, jeszcze nie znalaz³am prawdziwych dowodów.~
@111 = ~Rozmawia³eœ z Martinem? Jest druidem oraz cz³onkiem naszej grupy. Razem obserwowaliœmy gildiê. Dawniej do obserwacji zabójców korzystaliœmy z pomocy jego zwierz¹t. Mo¿liwe, ¿e posiada jakiœ wgl¹d w tê sprawê.~ ~Rozmawia³aœ z Martinem? Jest druidem oraz cz³onkiem naszej grupy. Razem obserwowaliœmy gildiê. Dawniej do obserwacji zabójców korzystaliœmy z pomocy jego zwierz¹t. Mo¿liwe, ¿e posiada jakiœ wgl¹d w tê sprawê.~
@112 = ~Balmorrow zaproponowa³ mi rozmowê z Martinem, miejscowym druidem. Mo¿e on posiadaæ informacje, które pomog³yby mi odnaleŸæ dowód na istnienie gildii.~
@113 = ~Dobra robota! Wiedzia³em, ¿e macza³a w tym palce. Tellish równie¿ mnie nie zaskoczy³. A wiêc co teraz zamierzasz uczyniæ?~
@114 = ~Oni s¹ ju¿ martwi. Wydaje mi siê, ¿e ksi¹¿ê bêdzie musia³ znaleŸæ nowego burmistrza dla tego miasta.~
@115 = ~Tellish nie ¿yje. Burmistrz mi umknê³a. Nie wydaje mi siê, by mia³o to jakieœ znaczenie. Jest ju¿ skoñczona.~
@116 = ~Pani burmistrz jest martwa. Jej doradca, Tellish, uciek³. W¹tpiê, by mia³o to jakiekolwiek znaczenie, on i jego gildia s¹ skoñczeni.~
@117 = ~Nie wiem. Chyba powinienem pomówiæ z nimi w sprawie dokumentów, które posiadam. Dojdzie do walki, jak mniemam.~ ~Nie wiem. Chyba powinnam pomówiæ z nimi w sprawie dokumentów, które posiadam. Dojdzie do walki, jak mniemam.~
@118 = ~Powinieneœ siê z nimi zmierzyæ. Jeœli zabierzesz dowody do Resten teraz, oni z pewnoœci¹ uciekn¹. B¹dŸ ostro¿ny, albowiem maj¹ za sob¹ gildiê.~ ~Powinnaœ siê z nimi zmierzyæ. Jeœli zabierzesz dowody do Resten teraz, oni z pewnoœci¹ uciekn¹. B¹dŸ ostro¿na, albowiem maj¹ za sob¹ gildiê.~
@119 = ~Jakieœ wieœci o postêpach?~
@120 = ~W takim razie ju¿ po wszystkim. Za wasze zas³ugi miasto Garrotten pozostanie wam d³u¿ne do koñca jego istnienia. Pewnie zaraz wyruszysz w drogê do Brodu Resten? Jeœli tak, dziêkujê raz jeszcze za to, czego dokonaliœcie.~
@121 = ~Jeszcze raz stokrotne dziêki za pozbycie siê gildii zabójców. Teraz mo¿emy powróciæ do ¿ycia, jakie niegdyœ znaliœmy.~
@122 = ~Nie ma sprawy, Balmorrow. ¯egnaj.~
