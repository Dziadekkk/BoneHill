@134 = ~Ja żem kopał go w ten pusty łeb, że aż zdechł. Har har.~ [BANDT01]
@135 = ~Eeee, a to było coś, har har.~ [BANDT03]
@136 = ~Przestań to robić!~ [BANDT04]
