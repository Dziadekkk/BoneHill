@166 = ~Pracownik budowy~
@167 = ~Służąca~
@168 = ~Eless~
@169 = ~Fabio~
@170 = ~Wybacz, ale nie gram na życzenie.~ [FABIO20]
@171 = ~Wybacz, muszę spadać. Panie mnie wzywają. Bywaj.~ [FABIO11]
@172 = ~Wiesz co? Masz rację. Może napiszę o tobie pieśń.~ [FABIO15]
@173 = ~Ta grupa ma jakieś poważne problemy.~ [FABIO12]
@174 = ~Wiecie, mam kilka lepszych zajęć, niż siedzenie tu z wami.~ [FABIO16]
@175 = ~To jest to. Skończyłem z tobą. Zapomnij o pieśni.~ [FABIO13]
@176 = ~Gdybym mógł królem być choć przez jeden dzień.~ [FABIOB]
@177 = ~Ziew. Panie, trzeba mi drzemki.~ [FABIOC]
@178 = ~Wiesz, to koliduje z mym uganianiem się za spódnicami.~ [FABIOD]
@179 = ~Zaśpiewam o twej śmierci!~ [FABIOA]
@180 = ~Kolejny głupiec gotowy zginąć z mojej ręki.~ [FABIO9]
@181 = ~Śmierć wam! Hmm, może powinienem to zapisać.~ [FABIO8]
@182 = ~Twa śmierć niewarta jest nawet jednej zwrotki w piosence.~ [FABIO10]
@183 = ~Za potrzebujących! Zaraz, zaraz, ja to już gdzieś słyszałem.~ [FABIO19]
@184 = ~Ał! Psiakrew, to bolało!~ [FABIOL]
@185 = ~Uch.~ [FABIOM]
@186 = ~Hej! Potrzebna mikstura, no szybciej!~ [FABIOE]
@187 = ~Ach, las, a wraz z nim wiele prywatności. Gdybym tylko miał panienkę do towarzystwa...~ [FABION]
@188 = ~Drogie Panie, proszę, ustawiamy się w kolejce.~ [FABIOO]
@189 = ~Ach, raczej nie ma sensu przemawiać tu z akcentem...~ [FABIOP]
@190 = ~Tylko w słońca promieniach można zobaczyć prawdziwe piękno mej twarzy.~ [FABIOQ]
@191 = ~*nuci sobie*~ [FABIOR]
@192 = ~Przysięgam, nie wiedziałem, ile miała lat.~ [FABIOG]
@193 = ~Tyle pięknych kobiet, a tak mało czasu.~ [FABIOF]
@194 = ~Było sobie raz dziewczę z Nantucket...~ [FABIOH]
@195 = ~Co się stało, chłopie?~ [FABIOX]
@196 = ~Wspomniałem może kiedyś o złodziejce z ogonem, którą poznałem? To było coś!~ [FABIO0]
@197 = ~Tak jest, dowódco!~ [FABIOT]
@198 = ~Miłostki, dziecinko, miłostki. Taaak!~ [FABIOI]
@199 = ~Nie nienawidź mnie tylko dlatego, że jestem piękny.~ [FABIOJ]
@200 = ~Pewnie. Mogę to zrobić.~ [FABIOK]
@201 = ~Hej! Ja tu pracuję.~ [FABIOY]
@202 = ~Strasznie dobry, sir.~ [FABIOU]
@203 = ~Och, jasne, dajcie mi to zrobić. Nie widzę, abyście się do tego rwali.~ [FABIO_]
@204 = ~Kolejny poległy bohater. Hmm, może powinienem napisać o nim pieśń.~ [FABIOW]
@205 = ~Wybornie!~ [FABIOV]
@206 = ~Oooo, taaak!~ [FABIOZ]
@207 = ~Co?! Ja nigdy nie chybiam.~ [FABIO1]
@208 = ~Co, u licha? Nie działa.~ [FABIO2]
@209 = ~Hej, ta paczka jest pełna, koleżko. Znajdź sobie innego muła.~ [FABIO3]
@210 = ~Ha ha ah!~ [FABIO4]
@211 = ~Fabio, słynny bard (za jakiego się uważa), wygląda, jakby zwiedził już cały świat. Podróżował przez liczne krainy z różnymi zespołami, ale... Niestety nic z tego, co plecie, nie jest pewne, i mogło się wcale nie zdarzyć. Jedynym pewnikiem jest to, że ma bzika na punkcie kobiet. Nie potrafi prowadzić rozmowy bez rozglądania się za niewiastami w pobliżu. Uważa się za kobieciarza, ale w rzeczywistości potrafi wyprowadzić z równowagi każdą z nich w ciągu kilku sekund. Uwielbia wymawiać słowa z różnymi akcentami, z nadzieją na poderwanie jakiejś przechodzącej dziewoi. Oby jego srebrny ale cięty jeżyk nigdy nie sprowadził na ciebie poważniejszych kłopotów.~
@212 = ~Fairwind~
@213 = ~Falco~
@214 = ~Falpir~
@215 = ~Felwin~
@216 = ~Bez wątpienia wolę tereny leśne, ale w tych czasach trzeba się umieć dostosować.~ [FELFF02]
@217 = ~~ [FELFF05]
@218 = ~~ [FELFF06]
@219 = ~Dzień dobry i witaj.~ [FELFF01]
