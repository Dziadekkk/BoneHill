@360 = ~Zelmar~
@361 = ~Kompilowanie nowych plikow~
@362 = ~Kompilowanie dialogow~
@363 = ~Instalowanie nowych lokacji~
@364 = ~Tutu zainstalowane, instalowanie plikow Tutu ~
@365 = ~Zamek w Brodzie Resten~
@366 = ~Koszary~
@367 = ~Magiczne Różności~
@368 = ~Zbroje, Bronie, Tarcze~
@369 = ~Donośne kroki strażników Brodu Resten budzą cię z drzemki.~
@370 = ~Łyse wzgórze~
@371 = ~Bród Resten~
@372 = ~Plebania~
@373 = ~Na południe do Garrotten~
@374 = ~Widzisz mały tunel. Był doskonale ukryty i nie wygląda, jakby był używany. Coś blokuję ci drogę do wejścia.~
@375 = ~Ktoś wykopał tunel pod ogrodzeniem.~
@376 = ~To musi być drzewo, na którym wieszano ludzi. Z ogromnych gałęzi zwisa kilka starych lin.~
@377 = ~Trójszczyt~
@378 = ~Tędy dojdziesz z powrotem do ołtarza. Możesz zakryć schody, aby nikt nie wiedział, że ktoś schodził na dół.~
@379 = ~W tych koszarach na pewno wybuchł kiedyś pożar. Większość dachu jest doszczętnie spalona.~
@380 = ~Dom wygląda na opuszczony. Drzwi są zarośnięte pnączami i krzakami.~
@381 = ~Łóżko, stół i reszta mebli jest zbutwiała i wygląda, jakby miała się zaraz rozlecieć.~
@382 = ~Zardzewiały sztylet wbity w tarczę do ćwiczeń.~
@383 = ~Ten tunel jest tak mały, że zmieszczą się tu jedynie szczury. To tędy wydostawały się z jaskiń.~
@384 = ~Sądząc po szczątkach, mógł to być złodziej. Poza kośćmi, ciemnym ubraniem i złamanym wytrychem nie ma tu nic ciekawego.~
@385 = ~Baron Brodu Resten~
@386 = ~Wieża Pelltara~
@387 = ~Wyjście~
@388 = ~Tu leży Joe, który zwykł mawiać: „Ten mod mnie wykończy!”~
@389 = ~Wygląda to na świeży grób.~
@390 = ~Jest tutaj mały tunel prowadzący w dół.~
@391 = ~Ten szkielet jest jeszcze świeży. Pozostałości ciemnych szat sugerują, że to zwłoki czarodzieja.~
@392 = ~Chyba ktoś przebudowywał tę katapultę. Kilka belek zostało wymienionych.~
@393 = ~Zauważasz, że okolica jest całkowicie pozbawiona roślinności.~
@394 = ~Wygląda to na mały, niedawno opuszczony fort. Lada moment się zawali.~
@395 = ~Spokojny las~
@396 = ~Wyjście z piwnicy~
@397 = ~Wyjście na powierzchnię~
@398 = ~Wzgórza głazów~
@399 = ~Na wschód – Bród Resten~
@400 = ~Kościane wzgórze~
@401 = ~Odetchnij na chwilę i oddaj się modlitwie w mej świątyni! Bóstwa mórz na pewno ci to wynagrodzą.~
@402 = ~Statua Osprem, bogini rybaków i żeglarzy.~
@403 = ~Naprzód pójdź ku morzu, wejdź na statek, by otrzymać dary. Potwory ich nakarm lub wyrwij je wodzie. To jest skarb mórz!~
@404 = ~Statua Xerbo, Boga morza~
@405 = ~Teatr Mistycznych Obchodów ~
@406 = ~Donośne kroki strażników Brodu Resten budzą cię z drzemki.~
@407 = ~Do Brodu Resten~
@408 = ~Do zamku~
@409 = ~Północna część miasta~
@410 = ~Południowa część miasta ~
@411 = ~Te dwie małe dziury w ścianie służyły zapewne jako punkt obserwacyjny dla kogoś ciekawskiego. Bez problemu można oglądać następny pokój.~
@412 = ~Na ścianie znajdują się przyrządy ogrodnicze i zabrudzone ubrania.~
@413 = ~Jest to statua bogini Osprem.~
@414 = ~Na półkach widać książki o tematyce religijnej i teologicznej.~
@415 = ~W tych beczkach znajdujesz mnóstwo broni i narzędzi. Niestety większość z nich jest zardzewiała i nie nadaje się do użytku.~
@416 = ~Te grube, puszyste dywany zostały zwinięte dla łatwego przechowywania.~
@417 = ~Zwisa tu rząd latarni. Sądząc po tonach kurzu, są tu od bardzo dawna.~
@418 = ~Na tym drewnianym stojaku zawieszono egzotycznie wyglądające ubranie. Wygląda to na strój złożony z jedwabnego kubraka z kwiecistymi ozdobami i pasującego turbanu.~
@419 = ~Niewątpliwie są to kiepskiej jakości, marnie wykonane skórzane sakwy. Szew jest luźny i chaotyczny i bez wątpienia nie nadają się one do przechowywania więcej niż kilku monet.~
@420 = ~Na całej długości lady stoi zbiór wyczyszczonych do połysku waz i lamp naftowych.~
@421 = ~Na tych półkach znajdują się przeróżne przedmioty, poczynając od książek i pergaminów, przez ubrania, po jedzenie i przybory kuchenne. Są one jednak niewiele warte.~
@422 = ~Nie wkraczaj z mocą broni w drzwi fortecy albo cię unicestwię.~
@423 = ~To jest statua Korda, Boga wojny.~
@424 = ~Te schody zawaliły się dawno temu, uniemożliwiając przedostanie się do dalszej części wieży. Ich naprawa nie została jeszcze ukończona.~
@425 = ~To zardzewiałe ustrojstwo wygląda na działające jeszcze organy.~
@426 = ~Ta część wieży zapadła się, pozostawiając spory otwór w podłodze.~
@427 = ~Na tym stole znajduje się mnóstwo narzędzi do otwierania zamków.~
@428 = ~Na tym stole znajduje się całe mnóstwo narzędzi tortur. Większość wygląda na często używane.~
@429 = ~Ten korytarz się zawalił.~
@430 = ~Widzisz wielkie wejście do jaskini, ale nie sposób jest zejść tędy. Może jest inne wejście?~
@431 = ~Wejście do jaskini~
@432 = ~Ta droga prowadzi do jeziora.~
@433 = ~Na północ – Garrotten~
@434 = ~Jakieś orcze bazgroły sprawiają, że ten znak jest całkowicie nieczytelny.~
@435 = ~BGT-Weidu zainstalowane, instalowanie plików BGT~
@436 = ~Aktualizacja plikow gry~
@437 = ~Zainstalowac nowe lokacje? Trzeba to wreszcie zrobic!~

@501 = ~Ta postać jest aktualnie na poziomie zerowym. Awansuj ją, by wybrać jej początkowe biegłości i umiejętności. (Do tego czasu ilość ich punktów życia, jak i ekwipunek mogą być nieco dziwne; nie przejmuj się tym. Gdy tylko podniesiesz ją na wyższy poziom, będzie mogła zdobyć więcej umiejętności (w zależności od twojego doświadczenia)).~

@750 = ~Doświadczony przywódca zbójców~

@1000 = ~Czy instalator powinien zbiffowac czesc zasobow SoBH?
[Y] tak, [N] nie~
@1001 = ~Komponent nie jest kompatybilny z ta wersja gry.~

