@124 = ~Pani Burmistrz Arrness~
@125 = ~Arthur~
@126 = ~Ascue~
@127 = ~Hoo ha ha ha ha ha.~ [OGREM01]
@128 = ~Umrzesz za to zuchwalstwo...~ [OGREM02]
@129 = ~Zdychaj, bydlaku!~ [OGREM04]
